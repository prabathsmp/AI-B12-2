# ---- Copy to .env and change the secrets ----
POSTGRES_DB=slotease
POSTGRES_USER=slotease
POSTGRES_PASSWORD=change-me-db-password

# Long random string, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

FRONTEND_PORT=8080
BACKEND_PORT=8000
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

DEFAULT_TIMEZONE=Asia/Kolkata
SLOT_STEP_MINUTES=15

# Seed two demo businesses (glow-salon, care-physio) on first start
SEED_DEMO=true

# Optional SMTP for e-mail confirmations (leave SMTP_HOST empty to only log them)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SlotEase <no-reply@slotease.local>

# NOTE: no OpenAI key here on purpose - each owner pastes their own key in
# Dashboard > Settings. It stays in their browser.
