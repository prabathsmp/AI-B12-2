    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const record = $json.output ?? $json;\n\n// Safely trim string fields\nfunction cleanString(value) {\n  return value == null ? '' : String(value).trim();\n}\n\n// Normalize name and general text fields\nfunction toTitleCase(value) {\n  return cleanString(value)\n    .toLowerCase()\n    .replace(/\\b[a-z]/g, char => char.toUpperCase());\n}\n\nconst name = toTitleCase(record.Name);\nconst email = cleanString(record['e-mail']).toLowerCase();\nconst course = toTitleCase(record.Course);\nconst city = toTitleCase(record.City);\n\nlet status = cleanString(record.Status).toLowerCase();\n\nconst statusMap = {\n  'enrolled': 'Enrolled',\n  'active': 'Active',\n  'pending': 'Pending',\n  'in progress': 'In Progress',\n  'completed': 'Completed',\n  'cancelled': 'Cancelled',\n  'canceled': 'Cancelled',\n  'on hold': 'On Hold'\n};\n\nstatus = statusMap[status] || toTitleCase(status);\n\nlet fee = cleanString(record.Fee_Paid).toLowerCase();\n\nconst feeMap = {\n  'yes': 'Yes',\n  'y': 'Yes',\n  'true': 'Yes',\n  '1': 'Yes',\n  'paid': 'Yes',\n  'no': 'No',\n  'n': 'No',\n  'false': 'No',\n  '0': 'No',\n  'partial': 'Partial',\n  'partially paid': 'Partial',\n  'unknown': 'Unknown',\n  'n/a': 'Unknown',\n  '': 'Unknown'\n};\n\nfee = feeMap[fee] || 'Unknown';\n\n// Preserve phone numbers as strings\nconst phone = cleanString(record.Phone);\n\n// Normalize dates only when their format is unambiguous\nfunction normalizeDate(value) {\n  const date = cleanString(value);\n\n  if (!date) return '';\n\n  // Already ISO formatted: validate the actual calendar date\n  let match = date.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n\n  if (match) {\n    const [, year, month, day] = match;\n    const d = new Date(`${year}-${month}-${day}T00:00:00Z`);\n\n    if (\n      d.getUTCFullYear() === Number(year) &&\n      d.getUTCMonth() + 1 === Number(month) &&\n      d.getUTCDate() === Number(day)\n    ) {\n      return date;\n    }\n\n    return '';\n  }\n\n  // Formats such as 03/02/2026 are ambiguous.\n  // Do not guess whether they mean DD/MM/YYYY or MM/DD/YYYY.\n  return '';\n}\n\nconst enrolledDate = normalizeDate(record['enrolled date']);\n\n// Validate email syntax; this is not proof that the address exists.\nconst emailValid =\n  /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\n// Basic phone validation: 10 digits, optionally with India's +91 prefix.\nconst phoneDigits = phone.replace(/\\D/g, '');\n\nconst phoneValid =\n  /^\\+?[\\d\\s()-]+$/.test(phone) &&\n  (phoneDigits.length === 10 ||\n   (phone.startsWith('+91') && phoneDigits.length === 12));\n\nconst missingFields = [];\n\nif (!name) missingFields.push('Name');\nif (!email) missingFields.push('e-mail');\nif (!course) missingFields.push('Course');\nif (!city) missingFields.push('City');\nif (!enrolledDate) missingFields.push('enrolled date');\n\nconst validationErrors = [];\n\nif (email && !emailValid) {\n  validationErrors.push('Invalid email');\n}\n\nif (!phoneValid) {\n  validationErrors.push('Invalid phone');\n}\n\nif (!statusMap[cleanString(record.Status).toLowerCase()]) {\n  validationErrors.push('Unrecognized status');\n}\n\nif (!feeMap[cleanString(record.Fee_Paid).toLowerCase()]) {\n  validationErrors.push('Unrecognized fee value');\n}\n\nreturn {\n  json: {\n    Name: name,\n    'e-mail': email,\n    Course: course,\n    Status: status,\n    Fee_Paid: fee,\n    Phone: phone,\n    City: city,\n    'enrolled date': enrolledDate,\n    email_valid: emailValid,\n    phone_valid: phoneValid,\n    missing_fields: missingFields,\n    validation_errors: validationErrors\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        128
      ],
      "id": "0ae8f9a9-d765-4ab0-b211-d3918463a32e",
      "name": "Transformation cleansing"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst seenEmails = new Set();\nconst seenRecords = new Set();\n\nconst uniqueRecords = [];\n\nfor (const item of items) {\n  const record = item.json;\n\n  const email = String(record['e-mail'] || '')\n    .trim()\n    .toLowerCase();\n\n  const name = String(record.Name || '')\n    .trim()\n    .toLowerCase();\n\n  const course = String(record.Course || '')\n    .trim()\n    .toLowerCase();\n\n  const phone = String(record.Phone || '')\n    .replace(/\\D/g, '');\n\n  const enrolledDate = String(record['enrolled date'] || '')\n    .trim();\n\n  // Prefer email as the primary identifier.\n  // Only use email for deduplication when it is present.\n  if (email) {\n    if (seenEmails.has(email)) {\n      continue;\n    }\n\n    seenEmails.add(email);\n  } else {\n    // For missing emails, require multiple matching fields.\n    const fallbackKey = [\n      name,\n      course,\n      phone,\n      enrolledDate\n    ].join('|');\n\n    if (\n      name &&\n      course &&\n      phone &&\n      enrolledDate &&\n      seenRecords.has(fallbackKey)\n    ) {\n      continue;\n    }\n\n    if (name && course && phone && enrolledDate) {\n      seenRecords.add(fallbackKey);\n    }\n  }\n\n  uniqueRecords.push(item);\n}\n\nreturn uniqueRecords;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1024,
        -64
      ],
      "id": "b55c44c0-2954-4506-b875-30ac70f1276c",
      "name": "De-Duplication cleansing"
    },
