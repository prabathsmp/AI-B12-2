    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"Name\": \"John Smith\",\n  \"e-mail\": \"john.smith@gmail.com\",\n  \"Course\": \"Python\",\n  \"Status\": \"Enrolled\",\n  \"Fee_Paid\": \"Yes\",\n  \"Phone\": \"9876543210\",\n  \"City\": \"Chennai\",\n  \"enrolled date\": \"2026-01-12\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
