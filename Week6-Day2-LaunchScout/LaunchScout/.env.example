# --- LLM (pluggable) -------------------------------------------------------
# Required: your OpenAI key (or paste it in the app sidebar instead)
OPENAI_API_KEY=sk-your-key-here
# Optional: model name (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint (Azure, OpenRouter, LM Studio, vLLM...)
OPENAI_BASE_URL=

# --- Search ----------------------------------------------------------------
# Optional: Serper.dev key for Google search. If blank, DuckDuckGo is used.
SERPER_API_KEY=
