# Copy to .env and fill in. .env is git-ignored and never baked into the Docker image.

# OpenAI key. Optional: you can instead paste it in the app sidebar at runtime
# (kept in that browser session's memory only).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: Azure / OpenAI-compatible proxy
# OPENAI_BASE_URL=

# Parallel LLM calls in chain.batch()
MAX_CONCURRENCY=8
# Automatic retries for invalid outputs before a review is marked 'needs_review'
MAX_RETRIES=2
# Seconds per LLM call
REQUEST_TIMEOUT=60
# Rows per batch (progress bar granularity)
CHUNK_SIZE=25
# Safety cap per upload
MAX_ROWS=2000
# Used in prompts / replies
BUSINESS_NAME=our restaurant

# Docker Compose host port and bind address (on a VPS behind nginx/caddy use 127.0.0.1)
APP_PORT=8501
BIND_ADDR=0.0.0.0
